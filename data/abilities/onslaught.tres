[ext_resource type="Script" path="res://scripts/data/ability_data.gd" id="1_fdwx3"]

[resource]
script = ExtResource("1_fdwx3")
id = &"onslaught"
display_name = "Onslaught"
description = "At the opening bell it runs straight forward down its own column until something stops it. The first ENEMY in the lane takes 1.2 times its attack damage per tier and is stunned for 0.45 seconds per tier — no moving, no swinging, no casting. An ally in the way blocks the charge and takes nothing; so does a wall. It moves whether or not it connects, so a charge into an empty lane leaves it standing at the far end having done nothing at all."
kind = 20
cast_time = 0.2
charge_damage_per_tier = 1.2
stun_seconds_per_tier = 0.45
