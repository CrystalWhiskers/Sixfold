[ext_resource type="Script" path="res://scripts/data/ability_data.gd" id="1_s1h0f"]

[resource]
script = ExtResource("1_s1h0f")
id = &"last_stand"
display_name = "Last Stand"
description = "Plants itself and roars. Every enemy within three tiles drops whatever it was doing and comes for it, and for four seconds it takes 90% less damage — but it cannot move and cannot swing while it holds. Only an empowered Paragon can do it."
kind = 11
cast_time = 0.6
requires_empowered = true
